# Copy to .env. Never commit real credentials.
APP_NAME="Conflux HQ"
ENVIRONMENT=development

# Supabase > Connect > Session pooler (port 5432).
# Replace PROJECT_REF, DB_PASSWORD and POOLER_HOST. URL-encode the password.
# SQLAlchemy talks directly to Supabase Postgres; API keys do not replace this URL.
DATABASE_URL=postgresql://postgres.PROJECT_REF:DB_PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
AUTO_CREATE_TABLES=false

# Explicit hackathon-only login. Never enable in production.
DEMO_MODE=true
DEMO_USERNAME="Zymic Bank"
DEMO_PASSWORD=123
# REQUIRED: generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Do not use the literal placeholder as your secret.
DEMO_TOKEN_SECRET=
DEMO_TOKEN_MINUTES=120

# Server-to-server scanner integration (random secret >=32 characters).
# Share only with the trusted scanner service, never browser code.
SOCIAL_ADAPTER_TOKEN="<32-char-hex-generated-above>"

# --- X (Twitter) API v2 Integration (Pay-Per-Use / Filtered Stream & Recent Search) ---
# Copy your App-Only Bearer Token from https://developer.x.com/en/portal/dashboard
# Leave X_BEARER_TOKEN empty to run in offline recorded-replay fallback mode.
X_BEARER_TOKEN=
X_API_BASE_URL=https://api.x.com/2
# Daily post-read guardrail ($0.005 per post read; 500 posts/day = $2.50/day cap)
X_DAILY_POST_LIMIT=500
X_TIMEOUT_SECONDS=15

# Future Supabase Auth mode (DEMO_MODE=false).
# Not required for demo login. Keep service role key strictly server-side.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SITE_URL=http://localhost:5173

# --- AI Orchestration (Anthropic Claude, Google Gemini, or Forge Huawei MaaS) ---
# Set AI_PROVIDER to "anthropic", "gemini" or "maas". Leave API keys empty for deterministic rules fallback.
AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-latest
ANTHROPIC_TIMEOUT_SECONDS=15
ANTHROPIC_MAX_RETRIES=1
ANTHROPIC_MAX_ATTEMPTS=2

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=15
GEMINI_MAX_RETRIES=1
GEMINI_MAX_ATTEMPTS=2

# --- Forge Huawei MaaS (cluster-internal, team10 namespace only) ---
# Enable with AI_PROVIDER=maas and MAAS_ENABLED=true. GATEWAY_KEY is the Forge
# team key: inject at runtime (pod secret), never commit it, never log it.
# Local dev and Render/Vercel cannot reach the MaaS hostname; wiring falls
# back to deterministic rules there.
MAAS_ENABLED=false
MAAS_BASE_URL=http://huawei-maas.ingress-apisix.svc.cluster.local/openai/v1
MAAS_MODEL=glm-5.2
MAAS_TIMEOUT_SECONDS=20
MAAS_MAX_ATTEMPTS=1
MAAS_RATE_LIMIT_PER_MINUTE=60

SPIKE_BUCKET_MINUTES=15
SPIKE_BASELINE_HOURS=24
SPIKE_MAD_MULTIPLIER=3.0
SPIKE_MIN_VOLUME=10
