# Copy to .env (never commit .env)
APP_NAME="Conflux HQ"
ENVIRONMENT=development

# --- Database ---
# Local quick start (run `alembic upgrade head` once):
DATABASE_URL=sqlite:///./conflux.db
# Supabase: Project Settings > Database > Connection string > "Session pooler" (port 5432).
# Paste it as-is; postgresql:// is converted to the psycopg driver automatically.
# DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
AUTO_CREATE_TABLES=false

# --- Supabase Auth (Project Settings > API) ---
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
# Server-side only. Never put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=
# Only for projects still using the legacy shared JWT secret (Settings > API > JWT Secret).
# Leave empty if your project uses signing keys (verified automatically through JWKS).
SUPABASE_JWT_SECRET=
# Where invite emails send people (your frontend URL)
SITE_URL=http://localhost:5173

# --- AI (Folarin) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Spike detection ---
SPIKE_BUCKET_MINUTES=15
SPIKE_BASELINE_HOURS=24
SPIKE_MAD_MULTIPLIER=3.0
SPIKE_MIN_VOLUME=10
